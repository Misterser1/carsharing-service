// ER-диаграмма базы данных (3NF) — формат DBML для https://dbdiagram.io
// Сервис аренды автомобилей (Carsharing / Rental API), вариант 5
// Импорт: dbdiagram.io -> Import -> From DBML

Project carsharing {
  database_type: 'PostgreSQL'
  Note: 'Сервис аренды автомобилей: пользователи, автопарк, тарифы, аренды, депозиты, платежи'
}

// ---------- Перечисления ----------
Enum user_role        { DRIVER OPERATOR ADMIN }
Enum user_status      { ACTIVE BLOCKED }
Enum license_status   { PENDING VERIFIED REJECTED }
Enum transmission     { MANUAL AUTOMATIC }
Enum fuel_type        { PETROL DIESEL ELECTRIC HYBRID }
Enum vehicle_status   { AVAILABLE RESERVED RENTED MAINTENANCE DECOMMISSIONED }
Enum rental_status    { RESERVED ACTIVE COMPLETED CANCELLED EXPIRED }
Enum reading_source   { TELEMATICS RENTAL_START RENTAL_END MANUAL }
Enum deposit_status   { HELD RELEASED CAPTURED PARTIALLY_CAPTURED FAILED }
Enum payment_type     { RENTAL_CHARGE FINE DEPOSIT_CAPTURE REFUND }
Enum payment_status   { PENDING SUCCEEDED FAILED REFUNDED }
Enum maintenance_type { SERVICE REPAIR REFUEL CLEANING INSPECTION }
Enum incident_status  { OPEN UNDER_REVIEW RESOLVED REJECTED }

// ---------- Пользователи ----------
Table users {
  id            uuid        [pk, default: `gen_random_uuid()`]
  email         varchar(255) [not null, unique]
  phone         varchar(20)  [not null, unique]
  password_hash varchar(255) [not null]
  full_name     varchar(150) [not null]
  role          user_role    [not null, default: 'DRIVER']
  status        user_status  [not null, default: 'ACTIVE']
  created_at    timestamptz  [not null, default: `now()`]
  updated_at    timestamptz  [not null, default: `now()`]

  indexes {
    role [name: 'ix_users_role']
  }
  Note: 'Учётные записи: водители, операторы автопарка, администраторы'
}

Table driver_profiles {
  user_id            uuid           [pk, ref: - users.id]
  birth_date         date           [not null]
  license_number     varchar(20)    [not null, unique]
  license_issued_at  date           [not null]
  license_expires_at date           [not null, note: 'CHECK (license_expires_at > license_issued_at)']
  license_status     license_status [not null, default: 'PENDING']
  license_scan_key   varchar(255)   [note: 'ключ файла скана ВУ в S3']
  verified_by        uuid           [ref: > users.id, note: 'оператор, подтвердивший ВУ']
  verified_at        timestamptz

  indexes {
    license_status [name: 'ix_driver_profiles_status']
  }
  Note: 'Профиль водителя (1:1 к users): данные водительского удостоверения'
}

// ---------- Автопарк ----------
Table vehicle_classes {
  id   smallint    [pk, increment]
  code varchar(20) [not null, unique, note: 'ECONOMY, COMFORT, BUSINESS, SUV']
  name varchar(50) [not null]
  Note: 'Классы автомобилей — основа тарификации'
}

Table vehicle_models {
  id              int          [pk, increment]
  class_id        smallint     [not null, ref: > vehicle_classes.id]
  brand           varchar(50)  [not null]
  model           varchar(50)  [not null]
  seats           smallint     [not null, note: 'CHECK (seats BETWEEN 1 AND 9)']
  transmission    transmission [not null]
  fuel_type       fuel_type    [not null]
  tank_capacity_l numeric(5,1) [note: 'CHECK (> 0); NULL для электромобилей']

  indexes {
    (brand, model) [unique, name: 'ux_vehicle_models_brand_model']
    class_id [name: 'ix_vehicle_models_class']
  }
  Note: 'Справочник марок / моделей'
}

Table locations {
  id        int          [pk, increment]
  name      varchar(100) [not null]
  address   varchar(255) [not null]
  latitude  numeric(9,6) [not null, note: 'CHECK (-90..90)']
  longitude numeric(9,6) [not null, note: 'CHECK (-180..180)']
  capacity  smallint     [not null, note: 'CHECK (> 0)']
  is_active boolean      [not null, default: true]
  Note: 'Парковки / зоны выдачи и возврата'
}

Table vehicles {
  id             uuid           [pk, default: `gen_random_uuid()`]
  model_id       int            [not null, ref: > vehicle_models.id]
  location_id    int            [ref: > locations.id, note: 'NULL, пока авто в поездке']
  plate_number   varchar(12)    [not null, unique, note: 'госномер']
  vin            char(17)       [not null, unique]
  year           smallint       [not null, note: 'CHECK (2000..2100)']
  color          varchar(30)    [not null]
  status         vehicle_status [not null, default: 'AVAILABLE']
  odometer_km    int            [not null, default: 0, note: 'текущий пробег, CHECK (>= 0)']
  fuel_level_pct smallint       [not null, default: 100, note: 'текущий уровень топлива, CHECK (0..100)']
  latitude       numeric(9,6)
  longitude      numeric(9,6)
  created_at     timestamptz    [not null, default: `now()`]
  updated_at     timestamptz    [not null, default: `now()`]

  indexes {
    status [name: 'ix_vehicles_status']
    model_id [name: 'ix_vehicles_model']
    location_id [name: 'ix_vehicles_location']
    (status, location_id) [name: 'ix_vehicles_status_location']
  }
  Note: 'Конкретные автомобили автопарка: статус доступности, текущий пробег и топливо'
}

Table features {
  id   smallint     [pk, increment]
  code varchar(30)  [not null, unique, note: 'CHILD_SEAT, GPS, WINTER_TIRES, ROOF_RACK ...']
  name varchar(100) [not null]
  Note: 'Справочник опций / оснащения'
}

Table vehicle_features {
  vehicle_id uuid     [ref: > vehicles.id]
  feature_id smallint [ref: > features.id]

  indexes {
    (vehicle_id, feature_id) [pk]
    feature_id [name: 'ix_vehicle_features_feature']
  }
  Note: 'Связь N:M автомобиль — опция'
}

// ---------- Тарифы ----------
Table tariffs {
  id               int           [pk, increment]
  class_id         smallint      [not null, ref: > vehicle_classes.id]
  name             varchar(100)  [not null]
  price_per_minute numeric(10,2) [not null, note: 'CHECK (>= 0)']
  price_per_km     numeric(10,2) [not null, note: 'CHECK (>= 0)']
  price_per_day    numeric(10,2) [not null, note: 'CHECK (>= 0)']
  deposit_amount   numeric(10,2) [not null, note: 'CHECK (>= 0); сумма блокировки депозита']
  currency         char(3)       [not null, default: 'RUB']
  valid_from       timestamptz   [not null, default: `now()`]
  valid_to         timestamptz   [note: 'NULL = бессрочно; CHECK (valid_to > valid_from)']
  is_active        boolean       [not null, default: true]

  indexes {
    (class_id, is_active) [name: 'ix_tariffs_class_active']
  }
  Note: 'Тарифы по классу авто; история хранится через valid_from / valid_to'
}

// ---------- Аренды ----------
Table rentals {
  id                     uuid          [pk, default: `gen_random_uuid()`]
  driver_id              uuid          [not null, ref: > users.id]
  vehicle_id             uuid          [not null, ref: > vehicles.id]
  tariff_id              int           [not null, ref: > tariffs.id, note: 'тариф, действовавший на момент брони']
  start_location_id      int           [ref: > locations.id]
  end_location_id        int           [ref: > locations.id]
  status                 rental_status [not null, default: 'RESERVED']
  reserved_at            timestamptz   [not null, default: `now()`]
  reservation_expires_at timestamptz   [not null]
  started_at             timestamptz
  ended_at               timestamptz   [note: 'CHECK (ended_at >= started_at)']
  start_odometer_km      int           [note: 'CHECK (>= 0)']
  end_odometer_km        int           [note: 'CHECK (end_odometer_km >= start_odometer_km)']
  start_fuel_pct         smallint      [note: 'CHECK (0..100)']
  end_fuel_pct           smallint      [note: 'CHECK (0..100)']
  total_amount           numeric(10,2) [note: 'итоговая сумма, фиксируется при завершении; CHECK (>= 0)']

  indexes {
    driver_id [name: 'ix_rentals_driver']
    vehicle_id [name: 'ix_rentals_vehicle']
    tariff_id [name: 'ix_rentals_tariff']
    (status, reservation_expires_at) [name: 'ix_rentals_status_expires']
    (driver_id, reserved_at) [name: 'ix_rentals_driver_reserved']
  }
  Note: 'Аренда: RESERVED -> ACTIVE -> COMPLETED | CANCELLED | EXPIRED. Частичные UNIQUE-индексы: одна активная аренда на авто и на водителя'
}

Table vehicle_readings {
  id             bigint         [pk, increment]
  vehicle_id     uuid           [not null, ref: > vehicles.id]
  rental_id      uuid           [ref: > rentals.id, note: 'NULL, если показание вне аренды']
  source         reading_source [not null]
  odometer_km    int            [not null, note: 'CHECK (>= 0)']
  fuel_level_pct smallint       [not null, note: 'CHECK (0..100)']
  latitude       numeric(9,6)
  longitude      numeric(9,6)
  recorded_at    timestamptz    [not null, default: `now()`]

  indexes {
    (vehicle_id, recorded_at) [name: 'ix_vehicle_readings_vehicle_time']
    rental_id [name: 'ix_vehicle_readings_rental']
  }
  Note: 'Журнал показаний одометра, топлива и GPS (телематика, старт/финиш аренды, ручной ввод)'
}

// ---------- Деньги ----------
Table deposit_holds {
  id               uuid           [pk, default: `gen_random_uuid()`]
  rental_id        uuid           [not null, unique, ref: - rentals.id]
  amount           numeric(10,2)  [not null, note: 'CHECK (> 0)']
  currency         char(3)        [not null]
  status           deposit_status [not null, default: 'HELD']
  captured_amount  numeric(10,2)  [not null, default: 0, note: 'CHECK (0 <= captured_amount <= amount)']
  provider_hold_id varchar(100)   [not null, unique, note: 'id операции hold в платёжном шлюзе']
  held_at          timestamptz    [not null, default: `now()`]
  released_at      timestamptz

  indexes {
    status [name: 'ix_deposit_holds_status']
  }
  Note: 'Блокировка депозита (1:1 к аренде): HELD -> RELEASED | CAPTURED | PARTIALLY_CAPTURED'
}

Table payments {
  id                      uuid           [pk, default: `gen_random_uuid()`]
  rental_id               uuid           [not null, ref: > rentals.id]
  type                    payment_type   [not null]
  status                  payment_status [not null, default: 'PENDING']
  amount                  numeric(10,2)  [not null, note: 'CHECK (> 0)']
  currency                char(3)        [not null]
  provider_transaction_id varchar(100)   [unique]
  created_at              timestamptz    [not null, default: `now()`]

  indexes {
    rental_id [name: 'ix_payments_rental']
    (status, created_at) [name: 'ix_payments_status_created']
  }
  Note: 'Платежи и списания по аренде: оплата поездки, штраф, удержание депозита, возврат'
}

// ---------- Эксплуатация ----------
Table maintenance_records {
  id          bigint           [pk, increment]
  vehicle_id  uuid             [not null, ref: > vehicles.id]
  operator_id uuid             [not null, ref: > users.id]
  type        maintenance_type [not null]
  description text
  cost        numeric(10,2)    [note: 'CHECK (>= 0)']
  odometer_km int              [not null, note: 'пробег на момент работ, CHECK (>= 0)']
  started_at  timestamptz      [not null, default: `now()`]
  finished_at timestamptz      [note: 'CHECK (finished_at >= started_at)']

  indexes {
    (vehicle_id, started_at) [name: 'ix_maintenance_vehicle_time']
    operator_id [name: 'ix_maintenance_operator']
  }
  Note: 'ТО, ремонт, заправка, мойка — переводят авто в статус MAINTENANCE'
}

Table incidents {
  id          uuid            [pk, default: `gen_random_uuid()`]
  rental_id   uuid            [not null, ref: > rentals.id]
  reported_by uuid            [not null, ref: > users.id]
  resolved_by uuid            [ref: > users.id, note: 'оператор']
  status      incident_status [not null, default: 'OPEN']
  description text            [not null]
  fine_amount numeric(10,2)   [note: 'CHECK (>= 0); сумма к удержанию из депозита']
  created_at  timestamptz     [not null, default: `now()`]
  resolved_at timestamptz

  indexes {
    rental_id [name: 'ix_incidents_rental']
    (status, created_at) [name: 'ix_incidents_status_created']
  }
  Note: 'Повреждения, штрафы, спорные ситуации по аренде'
}
