@startuml c4-context
' C4 Level 1 — System Context
' Сервис аренды автомобилей (Carsharing / Rental API), вариант 5
!include <C4/C4_Context>

title Диаграмма контекста (C4 Level 1) — Сервис аренды автомобилей

Person(driver, "Водитель", "Клиент сервиса: ищет свободное авто, бронирует, арендует и оплачивает поездки")
Person(operator, "Оператор автопарка", "Сотрудник компании: управляет автомобилями, тарифами, верифицирует водителей, разбирает инциденты")

System(platform, "Carsharing Platform", "Поиск и аренда автомобилей (поминутно / посуточно), учёт пробега и уровня топлива, статусы доступности авто, блокировка депозита, управление автопарком")

System_Ext(payment, "Платёжный шлюз", "ЮKassa / Stripe: блокировка (hold), списание (capture) и разблокировка (release) депозита, оплата поездок")
System_Ext(telematics, "Телематическая платформа", "Бортовые блоки автомобилей: GPS, одометр, уровень топлива, дистанционная блокировка/разблокировка дверей")
System_Ext(notify, "Сервис уведомлений", "Push (FCM/APNs) и SMS-шлюз")

Rel(driver, platform, "Бронирует и арендует авто, оплачивает поездки", "HTTPS")
Rel(operator, platform, "Управляет автопарком и тарифами, верифицирует ВУ, разбирает инциденты", "HTTPS")
Rel(platform, payment, "Блокирует / списывает / освобождает депозит, принимает оплату", "HTTPS/REST")
BiRel(platform, telematics, "Получает показания GPS, пробега, топлива; отправляет команды lock/unlock", "HTTPS/JSON")
Rel(platform, notify, "Отправляет push / SMS", "HTTPS/REST")
Rel(notify, driver, "Доставляет уведомления о брони, завершении поездки, списаниях")

SHOW_LEGEND()
@enduml
