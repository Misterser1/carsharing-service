# Шаблон настроек. Скопируйте в .env и задайте свой пароль: cp .env.example .env
# Сам .env в Git не коммитится; переменные окружения важнее значений из .env.

APP_NAME="Carsharing Rental API"
# development | test | production (в production отключается Swagger UI на /docs)
APP_ENV=development
APP_VERSION=1.0.0
APP_DEBUG=false
LOG_LEVEL=INFO

# HTTP-сервер. В docker compose HTTP_PORT — порт на хост-машине
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
# Автоперезагрузка при изменении кода (только при локальном запуске, в Docker выключена)
HTTP_RELOAD=true

# Разрешённые источники для CORS через запятую (веб-панель оператора)
CORS_ORIGINS=http://localhost:3000

# Параметры подключения к PostgreSQL.
# Пароль — только латинские буквы и цифры: он подставляется в URL сервиса migrate.
DB_USER=app_user
DB_PASSWORD=change_me
DB_NAME=carsharing
DB_MAX_CONNS=10
DB_CONNECT_ATTEMPTS=10

# Адрес БД для приложения, запущенного на хост-машине (python -m app).
# В docker compose приложению передаётся DB_HOST=db и DB_PORT=5432 — имя сервиса в сети Compose.
DB_HOST=localhost
DB_PORT=5432

# Порт PostgreSQL на хост-машине (если 5432 занят локальной PostgreSQL — 5433, и DB_PORT тоже)
DB_HOST_PORT=5432
